# Sway configuration adapted from the previous i3 setup for a 2019 T2 MacBook Air.

set $mod Mod4
set $alt Mod1
set $term foot
set $menu fuzzel
set $scripts ~/.config/sway/scripts

font pango:Source Code Pro 10

### Display and input
output eDP-1 scale 1.75
output * bg /home/zakinadhif/Dev/dotfiles/package_wallpapers/Pictures/Wallpapers/antarctica-mountain.jpg fill

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    scroll_factor 0.7
}

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 35
}

seat * hide_cursor 5000

### Session services
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec mako
exec nm-applet --indicator
exec lxpolkit
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 420 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

### Appearance and behavior
gaps inner 4
gaps outer 2
smart_gaps on
smart_borders on
default_border pixel 2
default_floating_border pixel 2
focus_follows_mouse no
floating_modifier $mod normal
workspace_auto_back_and_forth no
popup_during_fullscreen smart

set $base00 #101218
set $base01 #1f222d
set $base02 #252936
set $base03 #5e81ac
set $base04 #c0c5ce
set $base05 #d1d4e0
set $base08 #ee829f
set $accent #81a1c1

client.focused          #606c82 #606c82 #ffffff $accent
client.focused_inactive #2e3440 #2e3440 #888888 #2e3440
client.unfocused        #2e3440 #2e3440 #888888 #2e3440
client.urgent           #900000 #900000 #ffffff #900000
client.placeholder      #2e3440 #2e3440 #888888 #2e3440
client.background       #242424

### Common bindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Apple function/media keys.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioStop exec playerctl stop
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# Navigation and placement (kept from i3).
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent
bindsym $mod+z focus child

bindsym $mod+Shift+b border toggle
bindsym $mod+t border normal
bindsym $mod+y border pixel 1
bindsym $mod+u border none

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec $scripts/power-menu
bindsym $mod+Escape exec $scripts/power-menu
bindsym $mod+l exec swaylock -f
bindsym $mod+b exec pkill -SIGUSR1 waybar

### Screenshots
bindsym --release Print exec $scripts/screenshot all_save
bindsym --release Shift+Print exec $scripts/screenshot window_save
bindsym --release Control+Print exec $scripts/screenshot selection_save
bindsym --release Control+Shift+Print exec $scripts/screenshot selection_copy

# MacBook keyboard equivalents (there is no dedicated Print Screen key).
bindsym $mod+p exec $scripts/screenshot all_save
bindsym $mod+Shift+p exec $scripts/screenshot window_save
bindsym $mod+Control+p exec $scripts/screenshot selection_save
bindsym $mod+Control+Shift+p exec $scripts/screenshot selection_copy

### Workspaces
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Control+Right workspace next
bindsym $mod+Control+Left workspace prev
bindsym $mod+q workspace number $ws4

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Shift+Control+Right move container to workspace next; workspace next
bindsym $mod+Shift+Control+Left move container to workspace prev; workspace prev

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym Left resize shrink width 10 px
    bindsym Down resize grow height 10 px
    bindsym Up resize shrink height 10 px
    bindsym Right resize grow width 10 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Native Wayland app rules (app_id) plus XWayland compatibility (class).
assign [app_id="firefox"] $ws2
assign [class="Firefox"] $ws2
assign [app_id="discord"] $ws3
assign [class="discord"] $ws3
assign [app_id="libreoffice.*"] $ws4
assign [class="(?i)(Soffice|libreoffice.*)"] $ws4
assign [app_id="(?i)(mpv|vlc|audacity|gimp.*|org.inkscape.Inkscape)"] $ws5
assign [class="(?i)(mpv|vlc|audacity|gimp.*|inkscape)"] $ws5
assign [app_id="(?i)(pavucontrol|org.gnome.Settings|nm-connection-editor)"] $ws6

for_window [app_id="(?i)(pavucontrol|org.gnome.Calculator|org.gnome.FileRoller)"] floating enable
for_window [class="(?i)(Pavucontrol|Steam)"] floating enable
for_window [app_id="(?i)(pavucontrol|org.gnome.Calculator|org.gnome.FileRoller)"] move position center

### Waybar
bar {
    swaybar_command waybar
    mode dock
    hidden_state hide
    modifier $mod
}

include /etc/sway/config.d/*
